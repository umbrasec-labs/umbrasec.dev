    {
      "file": "rules/windows/remote-access-tool-service-install.yml",
      "rule_lines": [
        "selection_event:",
        "EventID: 7045",
        "tool_screenconnect_binary:",
        "ImagePath|contains: '\\ScreenConnect.ClientService.exe'",
        "tool_screenconnect_name:",
        "ServiceName|startswith: 'ScreenConnect Client'",
        "...",
        "condition: selection_event and 1 of tool_* and not 1 of filter_*"
      ]
    },
    {
      "file": "rules/cross-platform/ai-agent-cli-headless-approval-bypass.yml",
      "rule_lines": [
        "sel_claude_image:",
        "...",
        "- Image|contains: '/.local/share/claude/versions/'",
        "...",
        "sel_claude_bypass:",
        "- CommandLine|contains: ' --dangerously-skip-permissions'",
        "...",
        "condition: >-",
        "(sel_claude_image and sel_claude_bypass and sel_claude_headless) or",
        "..."
      ]
    },
    {
      "file": "queries/kql/all-agent-shells-risky-command.kql",
      "technique": "T1552.001",
      "tactic": "Credential Access",
      "claim": "catches/terminal-credential-read",
      "event_keys": [
        "_synthetic",
        "InitiatingProcessParentFileName",
        "InitiatingProcessCommandLine",
        "ProcessCommandLine"
      ],
      "rule_lines": [
        "...",
        "let Editors = dynamic([\"Code.exe\"]);",
        "...",
        "let CredentialMarkers = dynamic([\".aws/credentials\", @\".aws\\credentials\", \".ssh/id_\",",
        "...",
        "InitiatingProcessParentFileName in~ (Editors)",
        "and InitiatingProcessCommandLine has_any (ShellIntegrationMarkers), \"vscode-terminal\",",
        "...",
        "where ProcessCommandLine contains Marker",
        "..."
      ]
    },
    {
      "file": "rules/cross-platform/ai-agent-config-changed-by-command.yml",
      "technique": "T1546",
      "tactic": "Persistence",
      "claim": "catches/claude-wrapper-sed-settings",
      "event_keys": [
        "_synthetic",
        "Image",
        "CommandLine"
      ],
      "rule_lines": [
        "...",
        "config_path:",
        "CommandLine|contains:",
        "- '.claude/settings'",
        "...",
        "write_form:",
        "CommandLine|contains:",
        "...",
        "- '''sed -i'",
        "..."
      ]
    },
    {
      "file": "rules/cross-platform/ai-agent-config-new-file.yml",
      "technique": "T1195.002",
      "tactic": "Initial Access",
      "claim": "catches/new-file-by-node",
      "rule_lines": [
        "selection:",
        "TargetFilename|endswith:",
        "...",
        "- '/.mcp.json'",
        "...",
        "filter_git:",
        "Image|endswith:",
        "- '/git'",
        "- '\\git.exe'",
        "..."
      ]
    },
    {
      "file": "queries/kql/ai-agent-config-file-writes.kql",
      "technique": "T1546",
      "tactic": "Persistence",
      "claim": "catches/runtime-adds-mcp-server",
      "event_keys": [
        "_synthetic",
        "ActionType",
        "FileName",
        "FolderPath",
        "InitiatingProcessFileName"
      ],
      "rule_lines": [
        "...",
        "DeviceFileEvents",
        "...",
        "| extend Target = case(Path matches regex ConfigFiles, \"config\",",
        "...",
        "InitiatingProcessFileName in~ (RuntimeNames), \"runtime\",",
        "..."
      ]
    }
  ]
}
