      "file": "rules/windows/archiver-admin-share-collection.yml",
      "rule_lines": [
        "archiver_image:",
        "Image|endswith:",
        "- '\\WinRAR.exe'",
        "...",
        "add_command:",
        "CommandLine|contains:",
        "- ' a '",
        "...",
        "admin_share:",
        "CommandLine|contains:",
        "- '\\C$'",
        "..."
