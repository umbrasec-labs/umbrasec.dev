#!/usr/bin/env bash
#
# UMBRASEC pre-commit hook: keep derived files in sync with research/articles.json
#
# There is no CI for this site, by design: this hook is the only gate. It
# regenerates the derived files, stages exactly the ones it rewrote so a drift
# can never reach a commit, and re-runs build_indexes.py --check, which fails if:
#   - any generated file drifts from the manifest, or
#   - a research/*.html page exists that no manifest entry points to (orphan).
#
# The hook cannot auto-fix an orphan (it has no metadata for it), so it blocks
# the commit until you register the page in research/articles.json or delete it.
#
# It also runs gitleaks over the staged patch on every commit, regardless of
# which site-build path is taken.
#
# Generated files: index.html, research/index.html, feed.xml, sitemap.xml,
# assets/umbra.js (command palette), each research/<slug>.html prev/next nav,
# the tools/sigma-pack/index.html coverage table, and the shared footer on
# every site page (about, guide/*, tools/index, tools/sigma-pack).
#
# Before regenerating, it refuses to run if a file it would rewrite, or one of
# the generator's inputs, has unstaged edits: staging the regenerated file would
# otherwise sweep that unrelated work into the commit (and, on master, deploy it).
#
# Bypass with: git commit --no-verify
# Enable (once per clone): git config core.hooksPath .githooks

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Secret scan on the staged patch. Called on every exit path.
scan_secrets() {
    if ! command -v gitleaks >/dev/null 2>&1; then
        echo "pre-commit: gitleaks not found; refusing to commit unscanned changes" >&2
        echo "pre-commit: install gitleaks (see README), or bypass once with: git commit --no-verify" >&2
        exit 1
    fi
    # Scan only the lines this commit adds, fed directly to gitleaks, so a
    # scanner that errors out cannot pass as "nothing found": any non-zero exit,
    # whether a leak or a failure to scan, blocks the commit.
    local added
    added="$(git diff --cached --no-color --no-ext-diff | grep -E '^\+' | grep -vE '^\+\+\+ ' || true)"
    [ -n "$added" ] || return 0
    if ! printf '%s
' "$added" | gitleaks stdin --no-banner --redact --config .gitleaks.toml; then
        echo "pre-commit: gitleaks found a secret or PII in the staged changes, or failed to scan; aborting commit" >&2
        echo "pre-commit: review above, or bypass once with: git commit --no-verify" >&2
        exit 1
    fi
}

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: python3 not found; skipping site-build regen" >&2
    scan_secrets
    exit 0
fi

# Fast path: if everything is in sync and there are no orphans, still scan.
if python3 tools/site-build/build_indexes.py --check >/dev/null 2>&1; then
    scan_secrets
    exit 0
fi

# The files a regeneration would rewrite. The generator reads the working
# tree, so these and its inputs must match the index, or unstaged work would
# end up in the commit.
drift=()
while IFS= read -r path; do
    [ -n "$path" ] && drift+=("$path")
done < <(python3 tools/site-build/build_indexes.py --list-drift)

inputs=(research/articles.json tools/sigma-pack/README.md tools/site-build/build_indexes.py)
unstaged="$(git diff --name-only -- "${inputs[@]}" ${drift[@]+"${drift[@]}"})"
if [ -n "$unstaged" ]; then
    echo "pre-commit: site-build needs to regenerate, but these files have unstaged changes:" >&2
    printf '  %s\n' $unstaged >&2
    echo "pre-commit: stage them (git add) or stash them, then commit again" >&2
    exit 1
fi

echo "pre-commit: site-build out of sync, regenerating derived files..."
if ! python3 tools/site-build/build_indexes.py; then
    echo "pre-commit: build_indexes.py failed; aborting commit" >&2
    exit 1
fi

# Stage only the files the generator rewrote, and only tracked ones (-u never
# adds untracked files, so a brand-new article you have not git-added yet is
# left for you to add).
if [ ${#drift[@]} -gt 0 ]; then
    git add -u -- "${drift[@]}"
fi

# Gate: regeneration fixes drift but not orphans. If --check still fails, an
# unregistered research page exists - block so it cannot reach a commit.
if ! python3 tools/site-build/build_indexes.py --check; then
    echo "pre-commit: unresolved site-build problem (see above); aborting commit" >&2
    echo "pre-commit: fix it, or bypass once with: git commit --no-verify" >&2
    exit 1
fi

# Scan after staging, so regenerated files are covered too.
scan_secrets

echo "pre-commit: regenerated derived files staged into this commit."
exit 0